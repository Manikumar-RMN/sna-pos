# Copy to .env.local and fill in. NEVER commit the filled-in file.
#
# The publishable (anon) key is safe in the browser: Row Level Security is
# what protects the data, not the key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service-role key bypasses Row Level Security completely.
# It must never appear in browser code, in this repository, or in the
# SNA POS Agent. See docs/agent-architecture.md.
# SUPABASE_SERVICE_ROLE_KEY=
