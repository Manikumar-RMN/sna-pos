# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local — .gitignore already blocks it.

# The project URL and publishable key are safe in the browser: Row Level
# Security is what protects the data, not the key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The service-role key bypasses Row Level Security completely. It must never
# appear here, in browser code, in this repository, or in the SNA POS Agent.
# See docs/agent-architecture.md.
